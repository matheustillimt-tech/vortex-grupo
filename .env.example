# Copie este arquivo para .env.local e preencha. NUNCA suba o .env.local para o GitHub.

# --- Supabase (Project Settings > API) ---
# Endereço do seu projeto no Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública "anon" (pode ir pro navegador; o banco é protegido pelas regras de acesso).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon
# Chave "service_role" (secreta: só o servidor usa; nunca coloque em código de tela).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- Zapbot (conexão com o WhatsApp) ---
# Endereço da API do Zapbot (deixe como está, a não ser que o Zapbot mande outro).
ZAPBOT_API_URL=https://api.zapbot.online
# E-mail e senha da sua conta no Zapbot (o sistema faz login sozinho pra criar e ler as conexões).
ZAPBOT_EMAIL=seu-email@exemplo.com
ZAPBOT_PASSWORD=sua-senha-do-zapbot
# Opcional: um token de login do Zapbot já pronto. Vazio = o sistema faz login com e-mail e senha.
ZAPBOT_JWT=

# --- Segurança ---
# Chave de 32 bytes em base64 que embaralha os tokens das conexões no banco. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRYPTO_KEY=gere-uma-chave-de-32-bytes-em-base64
# Senha do agendador: quem chama /api/cron/tick precisa mandar "Authorization: Bearer <este valor>".
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=gere-um-segredo-longo

# --- Endereço público do sistema ---
# O domínio onde o painel fica no ar (sem "/" no fim). Vai nos links de grupo, deep links e webhooks.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# --- Marca (opcional) ---
# Nome que aparece no logo e na aba do navegador. Vazio = "Vórtex Grupo".
NEXT_PUBLIC_NOME_SISTEMA=
